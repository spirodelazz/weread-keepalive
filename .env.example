# ===== weread-keepalive 配置模板 =====
# 复制为 .env 并按需修改。所有变量也可通过系统环境变量设置（优先级更高）。

# ---- 必配 ----
# we-mp-rss 数据卷中的 wx.lic（YAML）。必须与容器 /app/data/wx.lic 指向同一物理文件。
# 例如 we-mp-rss 用 `docker run -v E:/wechat-rss-data:/app/data` 启动时：
WEREAD_LIC_PATH=E:/wechat-rss-data/wx.lic

# ---- 刷新行为 ----
# 持久化 Chrome profile 目录（登录态根基，建议放在与 wx.lic 同卷的稳定路径）
WEREAD_PROFILE_DIR=E:/wechat-rss-data/weread-chrome-profile
# 刷新页面 URL（微信读书 reader 页）。留空则读 wx.lic 里的 cookie_refresh_url
#WEREAD_REFRESH_URL=https://weread.qq.com/web/mp/reader/xxxx
# 本机 Chrome 路径（留空用 Playwright 自带 Chromium）
#WEREAD_BROWSER_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# 兜底校验的公众号 bookId（逗号分隔，写你自己在微信读书里关注的公众号）
#WEREAD_VERIFY_BOOK_IDS=MP_WXS_xxxx,MP_WXS_yyyy
# 计划任务冷却小时数（0 = 每次都真访问页面；agent 触发时始终强制 0）
#WEREAD_COOLDOWN_HOURS=0

# ---- 常驻代理 ----
# 默认只绑回环是正确配置（容器经 host.docker.internal 可达），不要改 0.0.0.0
#WEREAD_AGENT_HOST=127.0.0.1
#WEREAD_AGENT_PORT=9876
# 设置后 /refresh 必须携带 X-Agent-Token 头（绑非回环地址时必须设置）
#WEREAD_AGENT_TOKEN=

# ---- 探活监控 ----
#WEREAD_MONITOR_INTERVAL_SECONDS=900
#WEREAD_MONITOR_ALERT_FAILURES=2
# 告警渠道（可同时启用多个）
#WEREAD_NOTIFY_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
#WEREAD_NOTIFY_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
#WEREAD_NOTIFY_WEBHOOK=https://example.com/hook

# ===== 登录二维码推送（Docker / NAS / 无桌面服务器的扫码方案） =====
# 登录态失效无法无头恢复时，把登录二维码实时推到飞书，用微信「扫一扫 → 相册」
# 识别图片即可远程重建长期会话（方案与 robin 项目同源）。
# 前提：飞书自建应用（机器人发不出图片，图片必须经应用上传换 image_key）：
#   1. 飞书开放平台创建自建应用，开启「机器人」能力；
#   2. 开通权限：im:resource（上传图片）、im:message（发消息）、im:chat:readonly（查群）；
#   3. 把机器人加入目标群，`python qr_login.py --list-chats` 查 chat_id。
# 二维码图片上传（必需）
#FEISHU_APP_ID=cli_xxx
#FEISHU_APP_SECRET=xxx
# 投递目标：群 chat_id（应用消息）；不配则走下面的群机器人 webhook
#FEISHU_QR_RECEIVE_ID=oc_xxx
# 投递目标类型（chat_id / open_id / user_id，默认 chat_id）
#FEISHU_QR_RECEIVE_ID_TYPE=chat_id
# 卡片投递出口：app=强制应用消息，webhook=强制群机器人，留空=自适应（配了 receive_id 走 app）
#FEISHU_QR_SEND_MODE=
# 群机器人 webhook（卡片投递兜底出口，可与应用消息二选一或都配）
#FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# 群机器人开了「签名校验」才需要
#FEISHU_SECRET=
# 无头刷新失败需要扫码时自动推送（容器/NAS 无人值守场景开启）
#WEREAD_QR_PUSH_ON_EXPIRE=1
# 推送开关（默认开；桌面弹窗扫码的同时也会推一份到飞书，人不在电脑前也能扫）
#WEREAD_QR_PUSH_ENABLED=1
# 两次扫码推送会话的最小间隔（秒），防 profile 已死时每轮都打扰
#WEREAD_QR_SESSION_COOLDOWN_SECONDS=1800

# ===== 容器守护（Dockerfile 默认入口 start_daemon.py） =====
# 定时无头刷新间隔（秒），等价宿主机计划任务；compose 里另需设置
# WEREAD_AGENT_HOST=0.0.0.0 + WEREAD_AGENT_TOKEN（见 docker-compose.yml）
#WEREAD_DAEMON_REFRESH_SECONDS=900
